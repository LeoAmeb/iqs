# =============================================================================
# Backend — variables de entorno
# Copia este archivo a .env y ajusta los valores.
#
# Railway (producción): configura estas variables en el servicio "backend".
# Docker Compose (local): usa el .env.example de la raíz del monorepo.
# =============================================================================

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
# Desarrollo
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
# Producción → config.settings.production / False

SECRET_KEY=django-insecure-replace-me-with-a-50-char-random-string
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(50))"

JWT_SECRET_KEY=replace-me-with-independent-jwt-secret
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(50))"

# -----------------------------------------------------------------------------
# Hosts & CORS
# ALLOWED_HOSTS: solo hostname, sin protocolo (ej. "myapp.up.railway.app")
# CORS_ALLOWED_ORIGINS: URL completa con protocolo (ej. "https://myfrontend.up.railway.app")
# -----------------------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Base de datos
# Railway inyecta DATABASE_URL automáticamente al linkar el servicio Postgres.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/dbname
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=template_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Redis / Celery
# Railway inyecta REDIS_URL automáticamente al linkar el servicio Redis.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# OAuth social login (opcional)
# Google: https://console.developers.google.com
# GitHub: https://github.com/settings/apps
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email SMTP
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# Flower — UI de monitoreo de Celery (solo Docker Compose local)
# -----------------------------------------------------------------------------
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# Sentry (producción, opcional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
DJANGO_LOG_LEVEL=WARNING
