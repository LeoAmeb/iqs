# =============================================================================
# Docker Compose — desarrollo local
#
# Este archivo es SOLO para levantar el proyecto con docker compose.
# Para Railway u otro PaaS, usa los archivos de cada servicio:
#   Backend:  backend/.env.example
#   Frontend: frontend/.env.local.example
#
# Copia este archivo a .env en la raíz del monorepo.
# =============================================================================

# -----------------------------------------------------------------------------
# Django backend
# -----------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-me-in-production-use-50-char-random-string
JWT_SECRET_KEY=replace-me-with-independent-jwt-secret
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Base de datos (Docker Compose usa el servicio "postgres" interno)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@postgres:5432/template_db
POSTGRES_DB=template_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis (Docker Compose usa el servicio "redis" interno)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Flower — UI de monitoreo de Celery (http://localhost:5555)
# -----------------------------------------------------------------------------
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# OAuth social login (opcional)
# Google: https://console.developers.google.com
# GitHub: https://github.com/settings/apps
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (development usa consola por defecto)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Next.js frontend
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
