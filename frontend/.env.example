# =============================================================================
# Frontend — variables de entorno
# Copia este archivo a .env.local y ajusta los valores.
#
# Railway (producción): configura estas variables en el servicio "frontend".
# Docker Compose (local): usa el .env.example de la raíz del monorepo.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth.js
# NEXTAUTH_URL: URL pública del frontend (con protocolo)
#   Local:      http://localhost:3001
#   Producción: https://mi-frontend.up.railway.app
# NEXTAUTH_SECRET: cadena aleatoria — genera con: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# API del backend
# NEXT_PUBLIC_API_URL: URL del backend accesible desde el navegador
#   Local:      http://localhost:8000/api/v1
#   Producción: https://mi-backend.up.railway.app/api/v1
#
# INTERNAL_API_URL (opcional): URL interna para llamadas server-side en Railway
#   Ejemplo:    http://backend.railway.internal:8000/api/v1
#   Si no se define, se usa NEXT_PUBLIC_API_URL también para server-side.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# INTERNAL_API_URL=http://backend.railway.internal:8000/api/v1

# -----------------------------------------------------------------------------
# OAuth social login (opcional — mismos valores que en el backend)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
